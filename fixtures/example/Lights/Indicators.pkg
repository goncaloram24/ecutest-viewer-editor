<?xml version="1.0" encoding="utf-8"?>
<PACKAGE format-rev="7" prog-version="2024.1.0" xmlns="http://www.tracetronic.de/xml/ecu-test" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tracetronic.de/xml/ecu-test package.xsd">
	<INFORMATION format-rev="2" xsi:type="packageInfo">
		<DESCRIPTION xsi:type="string">Direction indicators: waits for the first flash, then checks the hazard mode.</DESCRIPTION>
		<VERSION xsi:type="string">1</VERSION>
	</INFORMATION>
	<VARIABLES xsi:type="variableContainer">
		<VARIABLE format-rev="1" in="true" xsi:type="variable">
			<NAME xsi:type="string">attempts</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="integer">10</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" xsi:type="variable">
			<NAME xsi:type="string">lamp</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="integer">0</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" in="true" xsi:type="variable">
			<NAME xsi:type="string">mode</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="string">LEFT</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
	</VARIABLES>
	<MAPPING format-rev="1" xsi:type="localMappingSpace">
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">IndicatorLever</ID>
			<XACCESS format-rev="1" xsi:type="xaBusSignalVariable">
				<MAPPING-ENUM xsi:type="vtabInfoEmpty"/>
				<BUS-KEY xsi:type="string">BODY_CAN</BUS-KEY>
				<FRAME-NAME xsi:type="string">LIGHT_CTRL</FRAME-NAME>
				<SIGNAL-NAME xsi:type="string">IND_LEVER</SIGNAL-NAME>
				<PDU-NAME xsi:type="string">LIGHT_CTRL</PDU-NAME>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">IndicatorLamp</ID>
			<XACCESS format-rev="1" xsi:type="xaBusSignalVariable">
				<MAPPING-ENUM xsi:type="vtabInfoEmpty"/>
				<BUS-KEY xsi:type="string">BODY_CAN</BUS-KEY>
				<FRAME-NAME xsi:type="string">LIGHT_STATUS</FRAME-NAME>
				<SIGNAL-NAME xsi:type="string">IND_LEFT_ON</SIGNAL-NAME>
				<PDU-NAME xsi:type="string">LIGHT_STATUS</PDU-NAME>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">HazardSwitch</ID>
			<XACCESS format-rev="1" xsi:type="xaBusSignalVariable">
				<MAPPING-ENUM xsi:type="vtabInfoEmpty"/>
				<BUS-KEY xsi:type="string">BODY_CAN</BUS-KEY>
				<FRAME-NAME xsi:type="string">LIGHT_CTRL</FRAME-NAME>
				<SIGNAL-NAME xsi:type="string">HAZARD</SIGNAL-NAME>
				<PDU-NAME xsi:type="string">LIGHT_CTRL</PDU-NAME>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
	</MAPPING>
	<TESTSTEPS xsi:type="testCase">
		<TESTSTEP format-rev="3" id="00000000-0000-4000-8000-000000000033" name="TsBlock" xsi:type="utility-2752ad1e-4fef-11dc-81d4-0013728784ee">
			<ACTION xsi:type="I18NItem">
				<MULTILANGDATA>
					<ELEMENT dkey="en_US">
						<DVALUE xsi:type="string">Left indicator</DVALUE>
					</ELEMENT>
				</MULTILANGDATA>
				<INITIAL-LANGUAGE xsi:type="string">en_US</INITIAL-LANGUAGE>
			</ACTION>
			<TESTSTEP id="00000000-0000-4000-8000-000000000024" xsi:type="tsWrite">
				<MAPPING-REF xsi:type="string">IndicatorLever</MAPPING-REF>
				<VALUE xsi:type="expressionValue">
					<DATA format-rev="2" xsi:type="valueBaseExpression">
						<VALUE xsi:type="integer">1</VALUE>
					</DATA>
				</VALUE>
				<METRIC format-rev="1" xsi:type="metricInfo">
					<Z-UNIT xsi:type="string">u_none</Z-UNIT>
					<VALUE-TYPE xsi:type="string">PHYS</VALUE-TYPE>
					<DATA-TYPE xsi:type="string">VALUE</DATA-TYPE>
				</METRIC>
			</TESTSTEP>
			<TESTSTEP id="00000000-0000-4000-8000-000000000031" name="TsLoop" xsi:type="utility-3da58cf0-4fef-11dc-be56-0013728784ee">
				<TESTSTEP id="00000000-0000-4000-8000-000000000025" xsi:type="tsRead">
					<MAPPING-REF xsi:type="string">IndicatorLamp</MAPPING-REF>
					<VARIABLE-REFS>
						<VARIABLE-NAME dkey="default">
							<DVALUE xsi:type="string">lamp</DVALUE>
						</VARIABLE-NAME>
					</VARIABLE-REFS>
					<METRIC format-rev="1" xsi:type="metricInfo">
						<Z-UNIT xsi:type="string">u_none</Z-UNIT>
						<VALUE-TYPE xsi:type="string">PHYS</VALUE-TYPE>
						<DATA-TYPE xsi:type="string">VALUE</DATA-TYPE>
					</METRIC>
				</TESTSTEP>
				<TESTSTEP id="00000000-0000-4000-8000-000000000029" name="TsIfThenElse" xsi:type="utility-3609c41e-4fef-11dc-899a-0013728784ee">
					<CONDITION xsi:type="compareOpBaseExpression">
						<NAME xsi:type="string">==</NAME>
						<FIRST-COMPONENT xsi:type="varBaseExpression">
							<NAME xsi:type="string">lamp</NAME>
						</FIRST-COMPONENT>
						<SECOND-COMPONENT format-rev="2" xsi:type="valueBaseExpression">
							<VALUE xsi:type="integer">1</VALUE>
						</SECOND-COMPONENT>
					</CONDITION>
					<THEN id="00000000-0000-4000-8000-000000000027" xsi:type="ifThenElseNode">
						<TESTSTEP id="00000000-0000-4000-8000-000000000026" name="TsBreak" xsi:type="utility-11b0144f-4e4f-11e0-b968-1c659df540cc"/>
					</THEN>
					<ELSE id="00000000-0000-4000-8000-000000000028" xsi:type="ifThenElseNode"/>
				</TESTSTEP>
				<TESTSTEP id="00000000-0000-4000-8000-000000000030" name="TsWait" xsi:type="utility-62d5a961-4fef-11dc-9944-0013728784ee">
					<TIME format-rev="2" xsi:type="valueBaseExpression">
						<VALUE xsi:type="float">0.05</VALUE>
					</TIME>
				</TESTSTEP>
				<LOOP-COUNT xsi:type="varBaseExpression">
					<NAME xsi:type="string">attempts</NAME>
				</LOOP-COUNT>
			</TESTSTEP>
			<TESTSTEP id="00000000-0000-4000-8000-000000000032" xsi:type="tsRead">
				<MAPPING-REF xsi:type="string">IndicatorLamp</MAPPING-REF>
				<EXPECTATION xsi:type="timelessOption">
					<EXPRESSION xsi:type="builtNumericExpression">
						<RELATION xsi:type="string">==</RELATION>
						<VALUE format-rev="2" xsi:type="valueBaseExpression">
							<VALUE xsi:type="integer">1</VALUE>
						</VALUE>
					</EXPRESSION>
				</EXPECTATION>
				<METRIC format-rev="1" xsi:type="metricInfo">
					<Z-UNIT xsi:type="string">u_none</Z-UNIT>
					<VALUE-TYPE xsi:type="string">PHYS</VALUE-TYPE>
					<DATA-TYPE xsi:type="string">VALUE</DATA-TYPE>
				</METRIC>
			</TESTSTEP>
		</TESTSTEP>
		<TESTSTEP format-rev="3" id="00000000-0000-4000-8000-000000000040" name="TsBlock" xsi:type="utility-2752ad1e-4fef-11dc-81d4-0013728784ee">
			<ACTION xsi:type="I18NItem">
				<MULTILANGDATA>
					<ELEMENT dkey="en_US">
						<DVALUE xsi:type="string">Hazard</DVALUE>
					</ELEMENT>
				</MULTILANGDATA>
				<INITIAL-LANGUAGE xsi:type="string">en_US</INITIAL-LANGUAGE>
			</ACTION>
			<TESTSTEP id="00000000-0000-4000-8000-000000000039" name="TsIfThenElse" xsi:type="utility-3609c41e-4fef-11dc-899a-0013728784ee">
				<CONDITION xsi:type="compareOpBaseExpression">
					<NAME xsi:type="string">==</NAME>
					<FIRST-COMPONENT xsi:type="varBaseExpression">
						<NAME xsi:type="string">mode</NAME>
					</FIRST-COMPONENT>
					<SECOND-COMPONENT format-rev="2" xsi:type="valueBaseExpression">
						<VALUE xsi:type="string">HAZARD</VALUE>
					</SECOND-COMPONENT>
				</CONDITION>
				<THEN id="00000000-0000-4000-8000-000000000037" xsi:type="ifThenElseNode">
					<TESTSTEP id="00000000-0000-4000-8000-000000000034" xsi:type="tsWrite">
						<MAPPING-REF xsi:type="string">HazardSwitch</MAPPING-REF>
						<VALUE xsi:type="expressionValue">
							<DATA format-rev="2" xsi:type="valueBaseExpression">
								<VALUE xsi:type="integer">1</VALUE>
							</DATA>
						</VALUE>
						<METRIC format-rev="1" xsi:type="metricInfo">
							<Z-UNIT xsi:type="string">u_none</Z-UNIT>
							<VALUE-TYPE xsi:type="string">PHYS</VALUE-TYPE>
							<DATA-TYPE xsi:type="string">VALUE</DATA-TYPE>
						</METRIC>
					</TESTSTEP>
					<TESTSTEP format-rev="1" id="00000000-0000-4000-8000-000000000035" name="TsComment" xsi:type="utility-1f4de951-4fef-11dc-969a-0013728784ee">
						<COMMENT-EXPRESSION format-rev="2" xsi:type="valueBaseExpression">
							<VALUE xsi:type="string">Hazard requested</VALUE>
						</COMMENT-EXPRESSION>
					</TESTSTEP>
				</THEN>
				<ELSE id="00000000-0000-4000-8000-000000000038" xsi:type="ifThenElseNode">
					<TESTSTEP format-rev="1" id="00000000-0000-4000-8000-000000000036" name="TsComment" xsi:type="utility-1f4de951-4fef-11dc-969a-0013728784ee">
