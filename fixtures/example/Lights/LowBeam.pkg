<?xml version="1.0" encoding="utf-8"?>
<PACKAGE format-rev="7" prog-version="2024.1.0" xmlns="http://www.tracetronic.de/xml/ecu-test" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tracetronic.de/xml/ecu-test package.xsd">
	<INFORMATION format-rev="2" xsi:type="packageInfo">
		<DESCRIPTION xsi:type="string">Low beam follows the light switch while the ignition is on.</DESCRIPTION>
		<VERSION xsi:type="string">1</VERSION>
	</INFORMATION>
	<VARIABLES xsi:type="variableContainer">
		<VARIABLE format-rev="1" in="true" xsi:type="variable">
			<NAME xsi:type="string">settleTime</NAME>
			<DESCRIPTION xsi:type="string">Seconds to wait after each stimulus</DESCRIPTION>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="float">0.5</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" xsi:type="variable">
			<NAME xsi:type="string">lampState</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="integer">0</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" out="true" xsi:type="variable">
			<NAME xsi:type="string">verdict</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="string">NONE</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
	</VARIABLES>
	<MAPPING format-rev="1" xsi:type="localMappingSpace">
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">Ignition</ID>
			<DESCRIPTION xsi:type="string">Terminal 15 state: 0 = off, 1 = on</DESCRIPTION>
			<XACCESS format-rev="1" xsi:type="xaBusSignalVariable">
				<MAPPING-ENUM xsi:type="vtabInfoEmpty"/>
				<BUS-KEY xsi:type="string">BODY_CAN</BUS-KEY>
				<FRAME-NAME xsi:type="string">BCM_STATUS</FRAME-NAME>
				<SIGNAL-NAME xsi:type="string">IGN_STATE</SIGNAL-NAME>
				<PDU-NAME xsi:type="string">BCM_STATUS</PDU-NAME>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">LightSwitch</ID>
			<XACCESS format-rev="1" xsi:type="xaBusSignalVariable">
				<MAPPING-ENUM xsi:type="vtabInfoEmpty"/>
				<BUS-KEY xsi:type="string">BODY_CAN</BUS-KEY>
				<FRAME-NAME xsi:type="string">LIGHT_CTRL</FRAME-NAME>
				<SIGNAL-NAME xsi:type="string">SWITCH_POS</SIGNAL-NAME>
				<PDU-NAME xsi:type="string">LIGHT_CTRL</PDU-NAME>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">LowBeamLamp</ID>
			<DESCRIPTION xsi:type="string">Feedback of the low beam output &lt;0|1&gt;</DESCRIPTION>
			<XACCESS format-rev="1" xsi:type="xaBusSignalVariable">
				<MAPPING-ENUM xsi:type="vtabInfoEmpty"/>
				<BUS-KEY xsi:type="string">BODY_CAN</BUS-KEY>
				<FRAME-NAME xsi:type="string">LIGHT_STATUS</FRAME-NAME>
				<SIGNAL-NAME xsi:type="string">LOW_BEAM_ON</SIGNAL-NAME>
				<PDU-NAME xsi:type="string">LIGHT_STATUS</PDU-NAME>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
	</MAPPING>
	<TESTSTEPS xsi:type="testCase">
		<TESTSTEP format-rev="3" id="00000000-0000-4000-8000-000000000002" name="TsPrecondBlock" xsi:type="utility-fd32d18b-c16d-45ca-9934-f8bffe11fcc3">
			<ACTION xsi:type="I18NItem">
				<MULTILANGDATA>
					<ELEMENT dkey="en_US">
						<DVALUE xsi:type="string">Ignition on</DVALUE>
					</ELEMENT>
				</MULTILANGDATA>
				<INITIAL-LANGUAGE xsi:type="string">en_US</INITIAL-LANGUAGE>
			</ACTION>
			<TESTSTEP format-rev="2" id="00000000-0000-4000-8000-000000000001" xsi:type="tsPackage">
				<PACKAGE-REFERENCE format-rev="2" xsi:type="valueBaseExpression">
					<VALUE xsi:type="string">Lib\PowerOn.pkg</VALUE>
				</PACKAGE-REFERENCE>
				<PARAM-ASSIGNMENTS>
					<ASSIGNMENT dkey="startupDelay">
						<DVALUE format-rev="2" xsi:type="valueBaseExpression">
							<VALUE xsi:type="integer">1</VALUE>
						</DVALUE>
					</ASSIGNMENT>
				</PARAM-ASSIGNMENTS>
			</TESTSTEP>
		</TESTSTEP>
		<TESTSTEP format-rev="3" id="00000000-0000-4000-8000-000000000006" name="TsBlock" xsi:type="utility-2752ad1e-4fef-11dc-81d4-0013728784ee">
