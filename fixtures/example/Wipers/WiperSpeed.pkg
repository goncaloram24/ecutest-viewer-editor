<?xml version="1.0" encoding="utf-8"?>
<PACKAGE format-rev="7" prog-version="2024.1.0" xmlns="http://www.tracetronic.de/xml/ecu-test" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tracetronic.de/xml/ecu-test package.xsd">
	<INFORMATION format-rev="2" xsi:type="packageInfo">
		<DESCRIPTION xsi:type="string">Wiper speed is derived from the stalk position.</DESCRIPTION>
		<VERSION xsi:type="string">1</VERSION>
	</INFORMATION>
	<VARIABLES xsi:type="variableContainer">
		<VARIABLE format-rev="1" in="true" xsi:type="variable">
			<NAME xsi:type="string">stalk</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="integer">2</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" xsi:type="variable">
			<NAME xsi:type="string">expectedSpeed</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="integer">0</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
		<VARIABLE format-rev="1" xsi:type="variable">
			<NAME xsi:type="string">speed</NAME>
			<DEFAULT-VALUE format-rev="1" xsi:type="value">
				<DATA xsi:type="integer">0</DATA>
			</DEFAULT-VALUE>
		</VARIABLE>
	</VARIABLES>
	<MAPPING format-rev="1" xsi:type="localMappingSpace">
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">WiperStalk</ID>
			<XACCESS format-rev="1" xsi:type="xaBusSignalVariable">
				<MAPPING-ENUM xsi:type="vtabInfoEmpty"/>
				<BUS-KEY xsi:type="string">BODY_CAN</BUS-KEY>
				<FRAME-NAME xsi:type="string">WIPER_CTRL</FRAME-NAME>
				<SIGNAL-NAME xsi:type="string">STALK_POS</SIGNAL-NAME>
				<PDU-NAME xsi:type="string">WIPER_CTRL</PDU-NAME>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
		<MAPPING-ITEM format-rev="2" xsi:type="mappingItem">
			<ID xsi:type="string">WiperMotorSpeed</ID>
			<XACCESS format-rev="1" xsi:type="xaModelValueVariable">
				<VARIABLE-PATH xsi:type="string">Plant/Wiper/Motor/speed_rpm</VARIABLE-PATH>
			</XACCESS>
			<AUTO-GENERATED xsi:type="boolean">False</AUTO-GENERATED>
		</MAPPING-ITEM>
	</MAPPING>
	<TESTSTEPS xsi:type="testCase">
		<TESTSTEP format-rev="1" id="00000000-0000-4000-8000-000000000041" name="TsComment" xsi:type="utility-1f4de951-4fef-11dc-969a-0013728784ee">
			<COMMENT-EXPRESSION format-rev="2" xsi:type="valueBaseExpression">
				<VALUE xsi:type="string">Speed is 20 rpm per stalk position</VALUE>
			</COMMENT-EXPRESSION>
		</TESTSTEP>
		<TESTSTEP format-rev="3" id="00000000-0000-4000-8000-000000000042" name="TsCalculation" xsi:type="utility-4115fa00-5f3c-11df-8a53-001c233b3528">
			<VARIABLE-REFS>
				<VARIABLE-NAME dkey="default">
					<DVALUE xsi:type="string">expectedSpeed</DVALUE>
				</VARIABLE-NAME>
			</VARIABLE-REFS>
			<FORMULA xsi:type="binaryOpBaseExpression">
				<NAME xsi:type="string">BINARY_MULTIPLY</NAME>
				<FIRST-COMPONENT xsi:type="varBaseExpression">
					<NAME xsi:type="string">stalk</NAME>
				</FIRST-COMPONENT>
				<SECOND-COMPONENT format-rev="2" xsi:type="valueBaseExpression">
					<VALUE xsi:type="integer">20</VALUE>
				</SECOND-COMPONENT>
			</FORMULA>
		</TESTSTEP>
		<TESTSTEP id="00000000-0000-4000-8000-000000000043" xsi:type="tsWrite">
			<MAPPING-REF xsi:type="string">WiperStalk</MAPPING-REF>
			<VALUE xsi:type="expressionValue">
				<DATA xsi:type="varBaseExpression">
					<NAME xsi:type="string">stalk</NAME>
				</DATA>
			</VALUE>
			<METRIC format-rev="1" xsi:type="metricInfo">
				<Z-UNIT xsi:type="string">u_none</Z-UNIT>
				<VALUE-TYPE xsi:type="string">PHYS</VALUE-TYPE>
				<DATA-TYPE xsi:type="string">VALUE</DATA-TYPE>
			</METRIC>
		</TESTSTEP>
		<TESTSTEP id="00000000-0000-4000-8000-000000000044" name="TsWait" xsi:type="utility-62d5a961-4fef-11dc-9944-0013728784ee">
			<TIME format-rev="2" xsi:type="valueBaseExpression">
				<VALUE xsi:type="integer">1</VALUE>
			</TIME>
		</TESTSTEP>
		<TESTSTEP id="00000000-0000-4000-8000-000000000045" xsi:type="tsRead">
			<MAPPING-REF xsi:type="string">WiperMotorSpeed</MAPPING-REF>
			<VARIABLE-REFS>
				<VARIABLE-NAME dkey="default">
					<DVALUE xsi:type="string">speed</DVALUE>
				</VARIABLE-NAME>
			</VARIABLE-REFS>
			<METRIC format-rev="1" xsi:type="metricInfo">
				<Z-UNIT xsi:type="string">u_none</Z-UNIT>
				<VALUE-TYPE xsi:type="string">PHYS</VALUE-TYPE>
				<DATA-TYPE xsi:type="string">VALUE</DATA-TYPE>
			</METRIC>
		</TESTSTEP>
		<TESTSTEP id="00000000-0000-4000-8000-000000000050" name="TsIfThenElse" xsi:type="utility-3609c41e-4fef-11dc-899a-0013728784ee">
			<CONDITION xsi:type="compareOpBaseExpression">
				<NAME xsi:type="string">&gt;=</NAME>
				<FIRST-COMPONENT xsi:type="varBaseExpression">
					<NAME xsi:type="string">speed</NAME>
				</FIRST-COMPONENT>
				<SECOND-COMPONENT xsi:type="varBaseExpression">
					<NAME xsi:type="string">expectedSpeed</NAME>
				</SECOND-COMPONENT>
			</CONDITION>
			<THEN id="00000000-0000-4000-8000-000000000048" xsi:type="ifThenElseNode">
				<TESTSTEP format-rev="1" id="00000000-0000-4000-8000-000000000046" name="TsComment" xsi:type="utility-1f4de951-4fef-11dc-969a-0013728784ee">
					<COMMENT-EXPRESSION format-rev="2" xsi:type="valueBaseExpression">
						<VALUE xsi:type="string">Speed reached</VALUE>
					</COMMENT-EXPRESSION>
					<COMMENT-VERDICT xsi:type="string">SUCCESS</COMMENT-VERDICT>
				</TESTSTEP>
			</THEN>
			<ELSE id="00000000-0000-4000-8000-000000000049" xsi:type="ifThenElseNode">
				<TESTSTEP format-rev="1" id="00000000-0000-4000-8000-000000000047" name="TsComment" xsi:type="utility-1f4de951-4fef-11dc-969a-0013728784ee">
					<COMMENT-EXPRESSION format-rev="2" xsi:type="valueBaseExpression">
						<VALUE xsi:type="string">Too slow</VALUE>
					</COMMENT-EXPRESSION>
					<COMMENT-VERDICT xsi:type="string">FAILED</COMMENT-VERDICT>
				</TESTSTEP>
			</ELSE>
		</TESTSTEP>
	</TESTSTEPS>
</PACKAGE>
